# Salin file ini menjadi .env lalu isi dengan nilai asli (jangan commit .env)

# Database SQLite (Prisma). Path relatif terhadap folder prisma/
DATABASE_URL="file:./database.db"

# Secret untuk signing session admin admin panel.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET="ganti-dengan-random-string-panjang"

# URL aplikasi
NEXTAUTH_URL="http://localhost:3000"

# Opsional. Password untuk akun admin yang dibuat oleh `npm run db:seed`.
# Kalau kosong, seed membuat password acak dan menampilkannya di terminal.
ADMIN_SEED_PASSWORD=""
